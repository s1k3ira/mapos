# Pasta de uploads: impede a execução de scripts enviados como anexo
<FilesMatch "\.(?i:php[0-9]*|phtml|phar|pht|phps|cgi|pl|py|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
